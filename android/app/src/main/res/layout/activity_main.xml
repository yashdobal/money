<?xml version="1.0" encoding="utf-8"?>
<!-- The web app fills the space between the status bar and the navigation bar (MainActivity sizes them from the
     window insets); the two strips behind the bars take the page's colours. The lock screen covers everything. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/ground" />

    <View
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="@color/ground" />

    <LinearLayout
        android:id="@+id/lock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:contentDescription="@null"
            android:src="@drawable/lock_badge" />

        <TextView
            android:id="@+id/lockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/lock_title"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/lock_text"
            android:textColor="@color/ink2"
            android:textSize="15sp" />

        <Button
            android:id="@+id/lockBtn"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/btn_accent"
            android:minWidth="200dp"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:stateListAnimator="@null"
            android:text="@string/lock_button"
            android:textAllCaps="false"
            android:textColor="@color/accent_ink"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
