{
  "expo": {
    "name": "Money RN",
    "slug": "money-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "moneyrn",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F6F6F4",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F6F4",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#0C0C0C"
      }
    },
    "android": {
      "package": "com.yashdobal.money.rn",
      "adaptiveIcon": {
        "backgroundColor": "#1E1E1E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_SMS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "defaultChannel": "alerts",
          "icon": "./assets/notification-icon.png",
          "color": "#1E1E1E"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#F6F6F4",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0C0C0C"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Money",
              "label": "Money",
              "description": "Safe to spend, your daily share, the balance until payday and what's coming up. Resize it from 1×1 to 5×4: it lays itself out to fit.",
              "minWidth": "57dp",
              "minHeight": "50dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-preview.png",
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "600dp"
            },
            {
              "name": "MoneySmall",
              "label": "Money: small",
              "description": "Starts as a 1×1 square with today's figure; stretch it and it shows more.",
              "minWidth": "57dp",
              "minHeight": "50dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widget-small-preview.png",
              "maxResizeWidth": "600dp",
              "maxResizeHeight": "600dp"
            }
          ],
          "fonts": [
            "./assets/fonts/Inter-Hero.ttf",
            "./assets/fonts/Inter-Fig.ttf",
            "./assets/fonts/Inter-Semi.ttf",
            "./assets/fonts/Inter-Medium.ttf",
            "./assets/fonts/Inter-Body.ttf"
          ]
        }
      ],
      "./plugins/with-money.js"
    ]
  }
}
